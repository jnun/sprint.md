# sprint.md Configuration
# Edit freely. Changes preserved across updates. Format: KEY=VALUE

# AI CLI binary for exec mode. Verified first-class profiles: claude, grok.
# Any other name falls back to a generic prompt passthrough. Inside an AI
# session, MODE=emit is used and this is ignored. See MODE below.
# Per-run override (does not rewrite this file): ./sprint.sh -c | -g <command>
# or env SPRINTMD_CLI / SPRINTMD_PROVIDER.
CLI=claude

# Capability tier for this install:
#   claude-code | grok-build | cursor | openai | generic
# Set by setup.sh from your provider choice. Scripts read it (via
# sprintmd_ai_tier) to use full orchestration on claude-code and grok-build,
# and degrade gracefully elsewhere. Empty = inferred from CLI above. See
# docs/sprintmd/ai/provider-capabilities.md.
# Per-run: ./sprint.sh -c (claude-code) or ./sprint.sh -g (grok-build).
PROVIDER=claude-code

# How AI commands deliver their prompt:
#   emit  — print the prompt for the agent you're already in (Claude Code,
#           Grok Build, Cursor, etc.) to run — no nested CLI
#   exec  — spawn the CLI binary above (for a plain terminal, loops, CI)
#   (empty) — auto: emit inside an agent session (CLAUDECODE, GROK_AGENT, …),
#             otherwise exec
MODE=

# Default model. Empty = let the CLI pick its own default (or a strong tier
# default on claude-code / grok-build via sprintmd_tier_model).
MODEL_DEFAULT=

# Per-script models. Empty = fall back to MODEL_DEFAULT.
# Interactive, reasoning-heavy flows (newfeature Q&A, newidea protocol, chat):
# when left empty on claude-code they default to opus; on grok-build to
# grok-4.5. Set a value here to pin a specific model instead.
MODEL_FEATURE=
MODEL_IDEA=
MODEL_CHAT=
MODEL_GATE=
MODEL_SPLIT=
MODEL_SPRINT=
MODEL_WORK=
MODEL_PROFILE=
MODEL_CODE_AUDIT=
MODEL_EXCELLENCE=
MODEL_POLISH=
MODEL_AUDIT=
MODEL_DEPS=
# Cheap pass for chat-folder / chat-bugs verdict-first sort (not a user command).
MODEL_TRIAGE=
# Dual-persona critique for `plan think` (not a user-facing top-level command).
MODEL_PLAN_THINK=
MODEL_DRIFT=

# Budget caps per invocation (USD). Empty = no cap.
BUDGET_WORK=5.00
BUDGET_AUDIT=3.00

# Code audit max iterative passes
AUDIT_MAX_PASSES=2
